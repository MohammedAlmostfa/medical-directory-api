{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.17",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^3.0",
        "nwidart/laravel-modules": "^13.3"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/boost": "^2.10",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12"
    },
"autoload": {
    "psr-4": {
        "App\\": "app/",
        "Modules\\Locations\\": "Modules/Locations/app/",
        "Modules\\Locations\\Database\\Factories\\": "Modules/Locations/database/factories/",
        "Modules\\Locations\\Database\\Seeders\\": "Modules/Locations/database/seeders/",
        "Modules\\Specialties\\": "Modules/Specialties/app/",
        "Modules\\Specialties\\Database\\Factories\\": "Modules/Specialties/database/factories/",
        "Modules\\Specialties\\Database\\Seeders\\": "Modules/Specialties/database/seeders/",
        "Modules\\Doctors\\": "Modules/Doctors/app/",
        "Modules\\Doctors\\Database\\Factories\\": "Modules/Doctors/database/factories/",
        "Modules\\Doctors\\Database\\Seeders\\": "Modules/Doctors/database/seeders/",
        "Modules\\Laboratories\\": "Modules/Laboratories/app/",
        "Modules\\Laboratories\\Database\\Factories\\": "Modules/Laboratories/database/factories/",
        "Modules\\Laboratories\\Database\\Seeders\\": "Modules/Laboratories/database/seeders/",
        "Modules\\Pharmacies\\": "Modules/Pharmacies/app/",
        "Modules\\Pharmacies\\Database\\Factories\\": "Modules/Pharmacies/database/factories/",
        "Modules\\Pharmacies\\Database\\Seeders\\": "Modules/Pharmacies/database/seeders/",
        "Modules\\Shared\\": "Modules/Shared/app/",
        "Modules\\Shared\\Database\\Factories\\": "Modules/Shared/database/factories/",
        "Modules\\Shared\\Database\\Seeders\\": "Modules/Shared/database/seeders/",
        "Modules\\WorkingHours\\": "Modules/WorkingHours/app/",
        "Modules\\WorkingHours\\Database\\Factories\\": "Modules/WorkingHours/database/factories/",
        "Modules\\WorkingHours\\Database\\Seeders\\": "Modules/WorkingHours/database/seeders/",
        "Modules\\MedicalCenters\\": "Modules/MedicalCenters/app/",
        "Modules\\MedicalCenters\\Database\\Factories\\": "Modules/MedicalCenters/database/factories/",
        "Modules\\MedicalCenters\\Database\\Seeders\\": "Modules/MedicalCenters/database/seeders/"
    },
    "classmap": [
        "database/seeders",
        "database/factories"
    ]
},
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
